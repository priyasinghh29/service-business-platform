# Application
APP_NAME="My App"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LARAVEL_INTERNAL_URL=http://laravel:9000

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app_db
DB_USERNAME=app_user
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment gateways (optional)
STRIPE_PK=
STRIPE_SK=
STRIPE_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional external payment microservice
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_URL=
